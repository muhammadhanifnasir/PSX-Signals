# ========================================================
# PSX Signal Intelligence - Environment Variables
# ========================================================

# BACKEND SETTINGS
PORT=8000
HOST=0.0.0.0
DATA_MODE=MOCK
MOCK_TICK_INTERVAL_SEC=4

# SUPABASE POSTGRESQL (Optional - Defaults to in-memory simulated database)
