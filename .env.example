# ==============================================================================
# PSX Signal Intelligence - Environment Variables Template
# ==============================================================================

# --- BACKEND SERVER SETTINGS ---
PORT=8000
HOST=0.0.0.0
# Set to LIVE for real PSX Data Portal collection, or MOCK for offline development
DATA_MODE=LIVE
MOCK_TICK_INTERVAL_SEC=4

# --- SECURITY & RATE LIMITING ---
# Generate a strong 64-character secret for production JWT signing
JWT_SECRET=generate-random-secret-key-32-chars-minimum
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://yourdomain.com"]

# --- SUPABASE POSTGRESQL & AUTH (OPTIONAL - DUAL SYNC COMPATIBLE) ---
# If left blank or placeholder, system uses local SQLite database in backend/data/psx_market_data.db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- TELEGRAM INSTANT ALERTS (OPTIONAL) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- FRONTEND CLIENT SETTINGS ---
NEXT_PUBLIC_APP_NAME="PSX Signal Intelligence"
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live-signals
NEXT_PUBLIC_DATA_MODE=LIVE
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
