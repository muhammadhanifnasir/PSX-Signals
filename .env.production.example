# ==============================================================================
# PSX Signal Intelligence - Production Environment Template (Ubuntu 24 VPS)
# ==============================================================================

# Node / Python Production Modes
NODE_ENV=production
DATA_MODE=LIVE
PORT=8000
HOST=127.0.0.1

# Security & Secret Keys
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_64_CHARACTER_RANDOM_STRING_FOR_PRODUCTION
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=["https://psxsignals.yourdomain.com","http://localhost:3000"]

# Supabase Production PostgreSQL Database & Auth
SUPABASE_URL=https://your-production-ref.supabase.co
SUPABASE_KEY=your-supabase-production-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Telegram Production Notification Channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend Production Client URLs (Must match public reverse-proxy domain)
NEXT_PUBLIC_APP_NAME="PSX Signal Intelligence"
NEXT_PUBLIC_API_URL=https://psxsignals.yourdomain.com/api
NEXT_PUBLIC_WS_URL=wss://psxsignals.yourdomain.com/ws/live-signals
NEXT_PUBLIC_DATA_MODE=LIVE
NEXT_PUBLIC_SUPABASE_URL=https://your-production-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
